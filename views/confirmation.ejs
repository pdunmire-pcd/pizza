<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Comfirmation</title>
</head>
<body>
    <h1>Thank you for your order, <%= order.fname %> <%= order.lname %>!</h1>
    <p>We will send updates to <%= order.email %>.</p>
    <p>Your order details:</p>
    <ul>
        <li>Pickup or Deliver: <%= order.method %></li>
        <li>Toppings: 
            <% if (order.toppings === "none") { %>
                none
            <% } else { %>
                <ul>
                    <% order.toppings.forEach(topping => { %>
                        <li><%= topping %></li>
                    <% }) %>
                </ul>
            <% } %>  

        </li>          
            
            <!-- <%= order.toppings %></li> -->
        <li>Size: <%= order.size %></li>
    </ul>
    
    <a href="/">Place another order</a>
</body>
</html>

